{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Palworld Server Mod Manager Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "managerEnabled",
    "runtime",
    "sourceRoot",
    "workshopRoot",
    "settingsPath",
    "statePath",
    "backupRoot",
    "mods"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "managerEnabled": {
      "type": "boolean"
    },
    "runtime": {
      "enum": [
        "linux-docker",
        "windows-dedicated"
      ]
    },
    "sourceRoot": {
      "type": "string",
      "minLength": 1
    },
    "workshopRoot": {
      "type": "string",
      "minLength": 1
    },
    "settingsPath": {
      "type": "string",
      "minLength": 1
    },
    "statePath": {
      "type": "string",
      "minLength": 1
    },
    "backupRoot": {
      "type": "string",
      "minLength": 1
    },
    "mods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workshopId",
          "displayName",
          "packageName",
          "enabled",
          "sourceFolder",
          "expectedSha256",
          "updatePolicy",
          "dependencies"
        ],
        "properties": {
          "workshopId": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "packageName": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "enabled": {
            "type": "boolean"
          },
          "sourceFolder": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "expectedSha256": {
            "type": "string",
            "pattern": "^(?:[A-Fa-f0-9]{64})?$"
          },
          "updatePolicy": {
            "const": "manual"
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          },
          "notes": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    }
  }
}
