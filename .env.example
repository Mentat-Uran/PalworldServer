# Palworld Server Console configuration template.
# Run scripts\bootstrap-first-run.ps1 to create .env and a random admin password.

# Runtime
TZ=UTC
PORT=8211
PLAYERS=32
COMMUNITY=false
PUBLIC_IP=
PUBLIC_PORT=
SERVER_NAME=Palworld Server
SERVER_DESCRIPTION=
ADMIN_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
SERVER_PASSWORD=
UPDATE_ON_BOOT=false
REST_API_ENABLED=true
REST_API_PORT=8212
RCON_ENABLED=false
RCON_PORT=25575
ENABLE_LEGACY_RCON=false
QUERY_PORT=27015
NETWORK_MODE=direct
TUNNEL_PROVIDER=none
TUNNEL_EXECUTABLE=
TUNNEL_ARGUMENTS=
TUNNEL_LOCAL_PORT=8211
TUNNEL_REMOTE_PORT=
CROSSPLAY_PLATFORMS=(Steam,Xbox,PS5,Mac)

# Backups are enabled as a safety default; choose the schedule and retention
# for your host during first-run setup.
BACKUP_ENABLED=true
BACKUP_CRON_EXPRESSION=0 0 * * *
DELETE_OLD_BACKUPS=true
OLD_BACKUP_DAYS=7
USE_BACKUP_SAVE_DATA=true

# Logging used by the image's REST/player integration
ENABLE_PLAYER_LOGGING=true
PLAYER_LOGGING_POLL_PERIOD=10
LOG_FILTER_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT_TYPE=Text

# Game settings
COOP_PLAYER_MAX_NUM=4
DAYTIME_SPEEDRATE=1.0
NIGHTTIME_SPEEDRATE=1.0
EXP_RATE=1.0
PAL_CAPTURE_RATE=1.0
PAL_SPAWN_NUM_RATE=1.0
PAL_DAMAGE_RATE_ATTACK=1.0
PAL_DAMAGE_RATE_DEFENSE=1.0
PLAYER_DAMAGE_RATE_ATTACK=1.0
PLAYER_DAMAGE_RATE_DEFENSE=1.0
PLAYER_STOMACH_DECREASE_RATE=1.0
PLAYER_STAMINA_DECREASE_RATE=1.0
PLAYER_AUTO_HP_REGEN_RATE=1.0
PLAYER_AUTO_HP_REGEN_RATE_IN_SLEEP=1.0
PAL_STOMACH_DECREASE_RATE=1.0
PAL_STAMINA_DECREASE_RATE=1.0
PAL_AUTO_HP_REGEN_RATE=1.0
PAL_AUTO_HP_REGEN_RATE_IN_SLEEP=1.0
BUILD_OBJECT_HP_RATE=1.0
BUILD_OBJECT_DAMAGE_RATE=1.0
BUILD_OBJECT_DETERIORATION_DAMAGE_RATE=1.0
COLLECTION_DROP_RATE=1.0
ENEMY_DROP_ITEM_RATE=1.0
DEATH_PENALTY=None
ENABLE_PLAYER_TO_PLAYER_DAMAGE=false
ENABLE_FRIENDLY_FIRE=false
IS_PVP=false
ENABLE_INVADER_ENEMY=true
DROP_ITEM_MAX_NUM=3000
BASE_CAMP_MAX_NUM=128
BASE_CAMP_WORKER_MAX_NUM=15
GUILD_PLAYER_MAX_NUM=20
PAL_EGG_DEFAULT_HATCHING_TIME=1.0
WORK_SPEED_RATE=1.0
AUTO_SAVE_SPAN=30
SUPPLY_DROP_SPAN=180
ENABLE_FAST_TRAVEL=true
SHOW_PLAYER_LIST=true
